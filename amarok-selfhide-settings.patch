+    // Only filter self for Settings callers. Keep System UI / dialer package discovery intact.
+    private static boolean isSettingsCaller() {
+        int callerPid = Binder.getCallingPid();
+        try {
+            Class<?> activityThread = XposedHelpers.findClass("android.app.ActivityThread", null);
+            Object thread = XposedHelpers.callStaticMethod(activityThread, "currentActivityThread");
+            Context context = (Context) XposedHelpers.callMethod(thread, "getSystemContext");
+            ActivityManager manager = context.getSystemService(ActivityManager.class);
+            if (manager == null) return false;
+            var processes = manager.getRunningAppProcesses();
+            if (processes == null) return false;
+            for (var process : processes) {
+                if (process.pid == callerPid) {
+                    return "com.android.settings".equals(process.processName)
+                            || process.processName.startsWith("com.android.settings:");
+                }
+            }
+        } catch (Throwable ignored) {
+            // Caller identification failure must leave Amarok visible.
+        }
+        return false;
+    }
