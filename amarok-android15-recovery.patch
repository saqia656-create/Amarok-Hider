diff --git a/app/src/main/java/deltazero/amarok/OpenAmarokTileService.java b/app/src/main/java/deltazero/amarok/OpenAmarokTileService.java
new file mode 100644
index 0000000..48710a8
--- /dev/null
+++ b/app/src/main/java/deltazero/amarok/OpenAmarokTileService.java
@@ -0,0 +1,38 @@
+package deltazero.amarok;
+
+import android.annotation.SuppressLint;
+import android.app.PendingIntent;
+import android.content.Intent;
+import android.os.Build;
+import android.service.quicksettings.Tile;
+import android.service.quicksettings.TileService;
+
+import deltazero.amarok.ui.MainActivity;
+
+/** User-initiated recovery entry point independent of dialer broadcasts and launcher aliases. */
+public class OpenAmarokTileService extends TileService {
+    @Override
+    public void onStartListening() {
+        Tile tile = getQsTile();
+        if (tile == null) return;
+        tile.setLabel(getString(R.string.open_amarok));
+        tile.setState(Tile.STATE_INACTIVE);
+        tile.updateTile();
+    }
+
+    @Override
+    @SuppressLint("StartActivityAndCollapseDeprecated")
+    public void onClick() {
+        unlockAndRun(() -> {
+            // MainActivity retains the normal app-lock/disguise flow.
+            Intent intent = new Intent(this, MainActivity.class)
+                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+                startActivityAndCollapse(PendingIntent.getActivity(this, 262765, intent,
+                        PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE));
+            } else {
+                startActivityAndCollapse(intent);
+            }
+        });
+    }
+}
